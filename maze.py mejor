#------------------------------------------------------------------------------#
#--------------------Maze Solver: Radar Inicial + Deflector 15°----------------#
#------------------------------------------------------------------------------#
# 1. Radar inicial para buscar salida.
# 2. Deflexion inteligente de 15° con proteccion Anti-Retorno (U-Turn).
# 3. Deteccion de callejon sin salida para girar 180° de forma controlada.

import os
import sys
import numpy as np
from pal.utilities.timing import Timer
from pal.products.sensors import SensorsTrainer
from pal.products.actuators import ActuatorsTrainer

# Importar funciones de cinematica del proyecto
parent_path = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.append(parent_path)
from mobile_robot_functions import MDLMovement

#===============================================================================
#region: Parametros Ajustables
#-------------------------------------------------------------------------------
TOTAL_RUNTIME  = 600         
MAIN_LOOP_RATE = 60          
DT = 1.0 / MAIN_LOOP_RATE
RAD_TO_DEG = 180.0 / np.pi

GYRO_BIAS_Z = 0.0898

# 1. UMBRALES DE DISTANCIA (m)
FRONT_STOP_DIST  = 0.22      # 22 cm: Distancia amplia para no raspar la trompa al rotar
SIDE_WALL_DIST   = 0.35      # 35 cm: AUMENTADO para que detecte la pared desde mas lejos
WALL_TARGET_DIST = 0.18      # 18 cm: AUMENTADO para que el chasis no vaya pegado a la pared

# 2. PARAMETROS DE MOVIMIENTO
INIT_SWEEP_ANGLE = 50.0      
DEFLECT_ANGLE    = 25.0      # AUMENTADO a 25 grados para mordiscos de giro mas amplios 
TURN_SPEED       = 0.50      # Ligeramente mas rapido para compensar el giro mas amplio
FWD_SPEED        = 0.015     # Velocidad super controlada (m/s)
KP_WALL          = 0.85      

# Estados de la Maquina de Estados (FSM)
STATE_INIT_RIGHT = 0         
STATE_INIT_LEFT  = 1         
STATE_INIT_ALIGN = 2         
STATE_FORWARD    = 3         
STATE_EVALUATE   = 4         
STATE_TURN_STEP  = 5         # Giro de los 15 grados
STATE_DEAD_END   = 6         # Giro de 180 para callejones sin salida
#endregion

#===============================================================================
#region: Funcion de Filtrado Anti-Reflejos
#-------------------------------------------------------------------------------
def get_zone_distance(dist_matrix, targets_matrix, fallback=1.5):
    valid_mask = (targets_matrix > 0) & (dist_matrix > 0.02) & (dist_matrix < 2.0)
    valid_dists = dist_matrix[valid_mask]
    if valid_dists.size > 0:
        return float(np.percentile(valid_dists, 25))
    return fallback
#endregion

#===============================================================================
#region: Inicializacion y Bucle Principal
#-------------------------------------------------------------------------------
timer = Timer(sampleRate=MAIN_LOOP_RATE, totalTime=TOTAL_RUNTIME)
movement = MDLMovement(whRadius=0.068, whDist=0.12)

state = STATE_INIT_RIGHT
accumulated_yaw = 0.0
best_yaw = 0.0
best_front_dist = 0.0
turn_yaw_accum = 0.0
current_deflection_accum = 0.0  # Suma total de los mordiscos
turn_direction = 1
is_deflecting = False
sample_count = 0

with (ActuatorsTrainer(block=3) as leftMotor,
      ActuatorsTrainer(block=1) as rightMotor,
      SensorsTrainer(ultraService=1, ultraStart=0.0, ultraLength=5.0) as sensors):

    leftMotor.enable_motors()
    rightMotor.enable_motors()
    print("Iniciando Radar + Deflector 15° con Anti-Retorno. Ctrl+C para detener.")

    try:
        while timer.check():
            # 1. Lectura de sensores
            sensors.read_outputs()
            gyro_z = sensors.gyro[2] * RAD_TO_DEG - GYRO_BIAS_Z
            ultra_raw = sensors.ultraDistance
            ultra_dist = ultra_raw if (0.02 < ultra_raw < 2.5) else 1.5

            tof_dist_mat = np.flip(sensors.TOFDistance.reshape(8, 8), axis=(0, 1))
            tof_targ_mat = np.flip(sensors.TOFNumberOfTargets.reshape(8, 8), axis=(0, 1))

            left_dist  = get_zone_distance(tof_dist_mat[2:6, 0:2], tof_targ_mat[2:6, 0:2])
            tof_center = get_zone_distance(tof_dist_mat[2:6, 3:5], tof_targ_mat[2:6, 3:5])
            right_dist = get_zone_distance(tof_dist_mat[2:6, 6:8], tof_targ_mat[2:6, 6:8])

            front_dist = min(tof_center, ultra_dist)

            fwdSpdCmd = 0.0
            turnSpdCmd = 0.0

            #===================================================================
            # 2. Maquina de Estados
            #===================================================================
            
            # --- FASE 1: RADAR INICIAL ---
            if state == STATE_INIT_RIGHT:
                turnSpdCmd = -TURN_SPEED
                accumulated_yaw += gyro_z * DT
                if front_dist > best_front_dist:
                    best_front_dist = front_dist
                    best_yaw = accumulated_yaw
                
                if accumulated_yaw <= -INIT_SWEEP_ANGLE:
                    state = STATE_INIT_LEFT

            elif state == STATE_INIT_LEFT:
                turnSpdCmd = TURN_SPEED
                accumulated_yaw += gyro_z * DT
                if front_dist > best_front_dist:
                    best_front_dist = front_dist
                    best_yaw = accumulated_yaw
                
                if accumulated_yaw >= INIT_SWEEP_ANGLE:
                    state = STATE_INIT_ALIGN

            elif state == STATE_INIT_ALIGN:
                turn_diff = best_yaw - accumulated_yaw
                if abs(turn_diff) <= 3.0: 
                    state = STATE_FORWARD
                    is_deflecting = False
                    current_deflection_accum = 0.0
                else:
                    turnSpdCmd = TURN_SPEED if turn_diff > 0 else -TURN_SPEED
                    accumulated_yaw += gyro_z * DT

            # --- FASE 2: NAVEGACION Y DEFLEXION DE 15° ---
            elif state == STATE_FORWARD:
                if front_dist <= FRONT_STOP_DIST:
                    fwdSpdCmd = 0.0
                    turnSpdCmd = 0.0
                    
                    # 1. REVISION DE CALLEJON SIN SALIDA (DEAD END)
                    if not is_deflecting and left_dist < 0.26 and right_dist < 0.26:
                        print("--> Callejon sin salida detectado. Girando 180.")
                        state = STATE_DEAD_END
                        accumulated_yaw = 0.0
                    else:
                        # 2. CAMBIO DE OPINION (Proteccion contra reflejos)
                        if is_deflecting:
                            if turn_direction == 1 and left_dist < 0.20 and right_dist > left_dist + 0.10:
                                print("--> Falso positivo izquierdo. Recalculando...")
                                is_deflecting = False
                            elif turn_direction == -1 and right_dist < 0.20 and left_dist > right_dist + 0.10:
                                print("--> Falso positivo derecho. Recalculando...")
                                is_deflecting = False
                            # 3. LIMITE ANTI-RETORNO (Max 105 grados de deflexion continua)
                            elif current_deflection_accum >= 105.0:
                                print("--> Maxima deflexion alcanzada sin salida. Recalculando...")
                                is_deflecting = False

                        if not is_deflecting:
                            state = STATE_EVALUATE
                        else:
                            state = STATE_TURN_STEP
                            turn_yaw_accum = 0.0
                else:
                    # Camino libre, reseteamos contadores de esquivar
                    fwdSpdCmd = FWD_SPEED
                    is_deflecting = False 
                    current_deflection_accum = 0.0
                    
                    # Logica de autocentrado mejorada con el nuevo WALL_TARGET_DIST
                    if left_dist < SIDE_WALL_DIST and right_dist < SIDE_WALL_DIST:
                        wall_error = left_dist - right_dist
                    elif right_dist < SIDE_WALL_DIST:
                        wall_error = WALL_TARGET_DIST - right_dist
                    elif left_dist < SIDE_WALL_DIST:
                        wall_error = left_dist - WALL_TARGET_DIST
                    else:
                        wall_error = 0.0
                        
                    turnSpdCmd = np.clip(KP_WALL * wall_error, -0.25, 0.25)

            elif state == STATE_EVALUATE:
                # Da prioridad a espacios que claramente son un pasillo abierto
                if right_dist > 0.35 and left_dist < 0.25:
                    turn_direction = -1
                elif left_dist > 0.35 and right_dist < 0.25:
                    turn_direction = 1
                else:
                    # Si no es obvio, solo compara el mayor
                    turn_direction = -1 if right_dist > left_dist else 1
                
                is_deflecting = True 
                turn_yaw_accum = 0.0
                current_deflection_accum = 0.0
                state = STATE_TURN_STEP

            elif state == STATE_TURN_STEP:
                turnSpdCmd = TURN_SPEED * turn_direction
                delta_yaw = gyro_z * DT
                turn_yaw_accum += delta_yaw
                
                if abs(turn_yaw_accum) >= DEFLECT_ANGLE:
                    current_deflection_accum += abs(turn_yaw_accum) 
                    state = STATE_FORWARD

            elif state == STATE_DEAD_END:
                # Ejecuta un giro riguroso de 180 grados para escapar
                fwdSpdCmd = 0.0
                turnSpdCmd = TURN_SPEED
                accumulated_yaw += gyro_z * DT
                if accumulated_yaw >= 175.0:
                    state = STATE_FORWARD
                    is_deflecting = False
                    current_deflection_accum = 0.0

            #===================================================================
            # 3. Enviar comandos a los motores
            #===================================================================
            leftSpdCmd, rightSpdCmd = movement.inverse_velocity_kinematics(fwdSpdCmd, turnSpdCmd)
            leftMotor.update_dc(-leftSpdCmd, limitCmd=False)
            rightMotor.update_dc(rightSpdCmd, limitCmd=False)
            leftMotor.write_motors()
            rightMotor.write_motors()

            if sample_count % 15 == 0:
                nombres = ["RADAR_DER", "RADAR_IZQ", "ALINEANDO", "AVANZA", "EVALUANDO", f"GIRO_{DEFLECT_ANGLE}°", "GIRO_180°"]
                print(f"[{nombres[state]}] Frente:{front_dist:.2f}m | Izq:{left_dist:.2f}m | Der:{right_dist:.2f}m | Deflex:{current_deflection_accum:.0f}°")

            sample_count += 1
            timer.sleep()

    finally:
        leftMotor.update_dc(0, limitCmd=False)
        rightMotor.update_dc(0, limitCmd=False)
        leftMotor.write_motors()
        rightMotor.write_motors()
        print("Motores detenidos.")
